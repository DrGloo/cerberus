# review.conf — per-project settings for the review hooks.
#
# Copy this file to `review.conf` in the same directory and edit. It is DATA,
# not shell: lib/review-core.sh reads it line by line and accepts only
# `KEY=VALUE` for the keys listed here. Quotes around a value are optional
# (one matching pair is stripped); nothing is expanded, so `$VAR`, `$(cmd)`
# and backticks are refused and reported. Blank lines and `#` comments are
# ignored. Any other line is reported and skipped. A value set in the
# environment (`REVIEW_MODEL=... git commit`) always wins over this file.

# Model the reviewer runs with. The `claude` CLI is used when it is on PATH;
# otherwise ANTHROPIC_API_KEY plus curl and python3 talk to the API directly.
REVIEW_MODEL=claude-sonnet-5

# Directories git-grep searches for callers and dangling references when it
# builds the prompt. "." is the whole tree. Narrow it on a repo with large
# docs or fixtures so the reviewer is not shown matches from prose.
#   REVIEW_SOURCE_DIRS="src lib"
REVIEW_SOURCE_DIRS=.

# Extra shell globs, space-separated, that are never worth a review pass. The
# built-in list already skips lockfiles, binary assets, vendored trees and
# generated code.
#   REVIEW_EXTRA_IGNORE="docs/* *.snap fixtures/*"
REVIEW_EXTRA_IGNORE=

# A static check to run over the staged reviewable files before the model
# sees them. Invoked from the repo root as `$REVIEW_LINT_CMD <file>...`; a
# non-zero exit blocks the commit without a model call. Leave empty to skip.
# Examples:
#   REVIEW_LINT_CMD="selene --allow-warnings --quiet"          # Luau
#   REVIEW_LINT_CMD="npx eslint --max-warnings=-1"             # JS/TS
#   REVIEW_LINT_CMD="ruff check"                               # Python
#   REVIEW_LINT_CMD="shellcheck -S error"                      # shell
REVIEW_LINT_CMD=

# Reserved, used by later changes: the linters and formatters the project
# runs, space-separated, so the reviewer is told which rules are not its
# business (formatting, import order, unused variables the linter flags).
#   REVIEW_LINT_TOOLS="selene stylua"

# Reserved, used by later changes: an extended regex matched against the
# path and the staged content of each changed file; a match attaches the
# whole file to the prompt regardless of REVIEW_CONTEXT_THRESHOLD.
#   REVIEW_CONTEXT_PATTERNS="OnServerEvent|OnServerInvoke"

# Timeouts, in seconds. The base covers the first 60000 bytes of prompt;
# every further 60000 bytes adds 90 seconds, capped at REVIEW_TIMEOUT_MAX.
# A timeout fails open (the commit goes through, is ledgered, and is
# re-reviewed at push), so err on the generous side.
REVIEW_TIMEOUT=180
REVIEW_TIMEOUT_MAX=600

# Changed lines in one file before its full current text is attached to the
# prompt as context, and the byte budgets for the diff and those attachments.
REVIEW_CONTEXT_THRESHOLD=30
REVIEW_MAX_DIFF_BYTES=200000
REVIEW_MAX_CONTEXT_BYTES=60000

# Reserved, used by later changes: how many file chunks an oversize diff may
# be split into before pre-push refuses the range.
#   REVIEW_MAX_CHUNKS=6
